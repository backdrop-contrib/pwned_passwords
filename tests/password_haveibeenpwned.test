    $this->assertNoRaw('<a href="/user/' . $this->authUser->uid . '/edit">Edit</a>',
      'User login was blocked.');
  }

  /**
   * Test user logging in with a bad password with a higher threshold.
   */
  public function testUserLoginBadPasswordHighThreshold() {

    // Set the breach count threshold higher than the default.
    variable_set('password_haveibeenpwned_password_threshold', 100);

    // Update the stored password for the user.
    // count is below 100.
    $edit['pass'] = 'drupal';
    user_save($this->authUser, $edit);

    // Set up form and submit it.
    $edit['name'] = $this->authUser->name;
    // Pass is already set in the $edit array.
    $this->drupalPost('user/', $edit, t('Log in'));

    $this->assertNoText(t('Your current password appears in'),
      'Warning not issued about compromised password.');
    $this->assertNoText(t('previous data breaches. You need to'),
      'User login with a bad password was not blocked.');
    $this->assertRaw('<a href="/user/' . $this->authUser->uid . '/edit">Edit</a>',
      'User logged in successfully.');
  }

  /**
   * Test user logging in with an incorrect password.
   */
  public function testUserLoginIncorrectPassword() {

    // Update the stored password for the user.
    $edit['pass'] = 'qwerty';
    user_save($this->authUser, $edit);

    // Try to login with a different bad password.
    $edit['pass'] = 'monkey';

    // Set up form and submit it.
    $edit['name'] = $this->authUser->name;
    // Pass is already set in the $edit array.
    $this->drupalPost('user/', $edit, t('Log in'));

    $this->assertNoText(t('Your current password appears in'),
      'No warning issued about compromised password when login failed.');
    $this->assertNoText(t('previous data breaches. You need to'),
      'User login with a bad password was not blocked.');
    $this->assertNoRaw('<a href="/user/' . $this->authUser->uid . '/edit">Edit</a>',
      'User did not log in successfully.');
  }

  /**
   * Test user logging in with an incorrect password with checked failed logins.
   */
  public function testUserLoginIncorrectPasswordCheckFailedLogins() {

    // Check passwords even when login fails (not the default).
    variable_set('password_haveibeenpwned_check_failed_login', TRUE);

    // Update the stored password for the user.
    $edit['pass'] = 'qwerty';
    user_save($this->authUser, $edit);

    // Try to login with a different bad password.
    $edit['pass'] = 'monkey';

    // Set up form and submit it.
    $edit['name'] = $this->authUser->name;
    // Pass is already set in the $edit array.
    $this->drupalPost('user/', $edit, t('Log in'));

    $this->assertText(t('The password you supplied appears in'),
      'Warning issued about compromised password despite failed login.');
    $this->assertNoText(t('previous data breaches. You need to'),
      'User login with a bad password was not blocked.');
    $this->assertNoRaw('<a href="/user/' . $this->authUser->uid . '/edit">Edit</a>',
      'User did not log in successfully.');
  }

}
