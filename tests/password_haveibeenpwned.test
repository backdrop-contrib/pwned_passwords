<?php

/**
 * @file
 * Automated tests for the Password Have I Been Pwned? module.
 */

/**
 * Provides a base test class and helper methods for automated tests.
 */
class PasswordHaveIBeenPwnedTestCase extends DrupalWebTestCase {

  protected $authUser;

  /**
   * {@inheritdoc}
   */
  public static function getInfo() {
    return array(
      'name' => 'Password Have I Been Pwned?',
      'description' => 'Tests Password Have I Been Pwned? module',
      'group' => 'Password Have I Been Pwned?',
    );
  }

  /**
   * {@inheritdoc}
   */
  public function setUp() {
    variable_set('clean_url', 1);
    global $base_url;

    // Enable module and dependencies.
    parent::setUp(
      array(
        'password_haveibeenpwned',
        'password_haveibeenpwned_test',
      )
    );

    // Switch HIBP API to use the mock endpoint.
    variable_set('password_haveibeenpwned_api_url', $base_url . '/password_haveibeenpwned_test/mock_api/');

    $this->authUser = $this->drupalCreateUser(
      array(
        'access comments',
        'access content',
        'use text format filtered_html',
      )
    );
  }

  /**
   * Test user registering with a (reasonably) good password.
   */
  public function testUserRegisterGoodPassword() {
    // Set up the site so users can register immediately and provide a password.
    variable_set('user_email_verification', FALSE);
    variable_set('user_register', USER_REGISTER_VISITORS);

    // Set up form and submit it.
    $edit['name'] = $this->randomName();
    $edit['mail'] = $edit['name'] . '@example.com';
    $edit['pass[pass1]'] = $edit['pass[pass2]'] = '6d296a0956e0d5a4a0c1f1a02d408bf6';
    $this->drupalPost('user/register', $edit, t('Create new account'));

    $this->assertNoText(t('The password you supplied appears in'),
      'Warning not issued about compromised password.');
    $this->assertNoText(t('You need to choose a different password for your account.'),
      'User registration with a bad password was not blocked.');
    $this->assertText(t('Registration successful. You are now logged in.'),
      'User registered successfully.');
  }

  /**
   * Test user registering with a bad password; by default should be blocked.
   */
  public function testUserRegisterBadPassword() {
    // Set up the site so users can register immediately and provide a password.
    variable_set('user_email_verification', FALSE);
    variable_set('user_register', USER_REGISTER_VISITORS);

    // Set up form and submit it.
    $edit['name'] = $this->randomName();
    $edit['mail'] = $edit['name'] . '@example.com';
    $edit['pass[pass1]'] = $edit['pass[pass2]'] = 'qwerty';
    $this->drupalPost('user/register', $edit, t('Create new account'));

    $this->assertText(t('The password you supplied appears in'),
      'Warning issued about compromised password.');
    $this->assertText(t('You need to choose a different password for your account.'),
      'User registration with a bad password was blocked.');
    $this->assertNoText(t('Registration successful. You are now logged in.'),
      'User was not registered successfully.');
  }

  /**
   * Test user registering with a bad password with policy set to Ignore.
   */
  public function testUserRegisterBadPasswordPolicyIgnore() {
    // Set up the site so users can register immediately and provide a password.
    variable_set('user_email_verification', FALSE);
    variable_set('user_register', USER_REGISTER_VISITORS);

    // Set Register Policy to Ignore.
    variable_set('password_haveibeenpwned_register_policy', PASSWORD_HAVEIBEENPWNED_IGNORE);

    // Set up form and submit it.
    $edit['name'] = $this->randomName();
    $edit['mail'] = $edit['name'] . '@example.com';
    $edit['pass[pass1]'] = $edit['pass[pass2]'] = 'qwerty';
    $this->drupalPost('user/register', $edit, t('Create new account'));

    $this->assertNoText(t('The password you supplied appears in'),
      'Warning not issued about compromised password.');
    $this->assertNoText(t('You need to choose a different password for your account.'),
      'User registration with a bad password was not blocked.');
    $this->assertText(t('Registration successful. You are now logged in.'),
      'User registered successfully.');
  }

  /**
   * Test user registering with a bad password with policy set to Warn.
   */
  public function testUserRegisterBadPasswordPolicyWarn() {
    // Set up the site so users can register immediately and provide a password.
    variable_set('user_email_verification', FALSE);
    variable_set('user_register', USER_REGISTER_VISITORS);

    // Set Register Policy to Warn.
    variable_set('password_haveibeenpwned_register_policy', PASSWORD_HAVEIBEENPWNED_WARN);

    // Set up form and submit it.
    $edit['name'] = $this->randomName();
    $edit['mail'] = $edit['name'] . '@example.com';
    $edit['pass[pass1]'] = $edit['pass[pass2]'] = 'qwerty';
    $this->drupalPost('user/register', $edit, t('Create new account'));

    $this->assertText(t('The password you supplied appears in'),
      'Warning issued about compromised password.');
    $this->assertNoText(t('You need to choose a different password for your account.'),
      'User registration with a bad password was not blocked.');
    $this->assertText(t('Registration successful. You are now logged in.'),
      'User registered successfully.');
  }

  /**
   * Test user registering with a bad password, with higher threshold.
   */
  public function testUserRegisterBadPasswordHighThreshold() {
    // Set up the site so users can register immediately and provide a password.
    variable_set('user_email_verification', FALSE);
    variable_set('user_register', USER_REGISTER_VISITORS);

    // Set the breach count threshold higher than the default.
    variable_set('password_haveibeenpwned_password_threshold', 100);

    // Set up form and submit it.
    $edit['name'] = $this->randomName();
    $edit['mail'] = $edit['name'] . '@example.com';
    // Count is below 100.
    $edit['pass[pass1]'] = $edit['pass[pass2]'] = 'drupal';
    $this->drupalPost('user/register', $edit, t('Create new account'));

    $this->assertNoText(t('The password you supplied appears in'),
      'Warning not issued about compromised password.');
    $this->assertNoText(t('You need to choose a different password for your account.'),
      'User registration with a bad password was not blocked.');
    $this->assertText(t('Registration successful. You are now logged in.'),
      'User was not registered successfully.');
  }

  /**
   * Test changing a user password to a (reasonably) good one.
   */
  public function testUserEditGoodPassword() {

    $this->drupalLogin($this->authUser);

    $edit['pass[pass1]'] = $edit['pass[pass2]'] = '6d296a0956e0d5a4a0c1f1a02d408bf6';
    $this->drupalPost('user/' . $this->authUser->uid . '/edit', $edit, t('Save'));

    $this->assertNoText(t('The password you supplied appears in'),
      'Warning not issued about compromised password.');
    $this->assertNoText(t('The new password you supplied appears in'),
      'User edit with a good password was not blocked.');
    $this->assertText(t('The changes have been saved.'),
      'New (good) password was saved.');
  }

  /**
   * Test changing a user password to a bad one; by default should be blocked.
   */
  public function testUserEditBadPassword() {

    $this->drupalLogin($this->authUser);

    $edit['pass[pass1]'] = $edit['pass[pass2]'] = 'monkey';
    $this->drupalPost('user/' . $this->authUser->uid . '/edit', $edit, t('Save'));

    $this->assertText(t('The new password you supplied appears in'),
      'Warning issued about compromised password.');
    $this->assertText(t('You should choose a different password.'),
      'User edit with a bad password was blocked.');
    $this->assertNoText(t('The changes have been saved.'),
      'New (bad) password was not saved.');
  }

  /**
   * Test changing a user password to a bad one with policy set to Ignore.
   */
  public function testUserEditBadPasswordPolicyIgnore() {

    // Set Change Policy to Ignore.
    variable_set('password_haveibeenpwned_change_policy', PASSWORD_HAVEIBEENPWNED_IGNORE);

    $this->drupalLogin($this->authUser);

    $edit['pass[pass1]'] = $edit['pass[pass2]'] = 'monkey';
    $this->drupalPost('user/' . $this->authUser->uid . '/edit', $edit, t('Save'));

    $this->assertNoText(t('The password you supplied appears in'),
      'Warning not issued about compromised password.');
    $this->assertNoText(t('The new password you supplied appears in'),
      'User edit with a good password was not blocked.');
    $this->assertText(t('The changes have been saved.'),
      'New (good) password was saved.');
  }

  /**
   * Test changing a user password to a bad one with policy set to Warn.
   */
  public function testUserEditBadPasswordPolicyWarn() {

    // Set Change Policy to Warn.
    variable_set('password_haveibeenpwned_change_policy', PASSWORD_HAVEIBEENPWNED_WARN);

    $this->drupalLogin($this->authUser);

    $edit['pass[pass1]'] = $edit['pass[pass2]'] = 'monkey';
    $this->drupalPost('user/' . $this->authUser->uid . '/edit', $edit, t('Save'));

    $this->assertText(t('The password you supplied appears in'),
      'Warning issued about compromised password.');
    $this->assertNoText(t('The new password you supplied appears in'),
      'User edit with a good password was not blocked.');
    $this->assertText(t('The changes have been saved.'),
      'New (bad) password was saved.');
  }

  /**
   * Test changing a user password to a bad one, with higher threshold.
   */
  public function testUserEditBadPasswordHighThreshold() {

    // Set the breach count threshold higher than the default.
    variable_set('password_haveibeenpwned_password_threshold', 100);

    $this->drupalLogin($this->authUser);

    // Count is below 100.
    $edit['pass[pass1]'] = $edit['pass[pass2]'] = 'drupal';
    $this->drupalPost('user/' . $this->authUser->uid . '/edit', $edit, t('Save'));

    $this->assertNoText(t('The password you supplied appears in'),
      'Warning not issued about compromised password.');
    $this->assertNoText(t('The new password you supplied appears in'),
      'User edit with a bad(ish) password was not blocked.');
    $this->assertText(t('The changes have been saved.'),
      'New (badish) password was saved.');
  }

  /**
   * Test user logging in with a (reasonably) good password.
   */
  public function testUserLoginGoodPassword() {

    // Update the stored password for the user.
    $edit['pass'] = '6d296a0956e0d5a4a0c1f1a02d408bf6';
    user_save($this->authUser, $edit);

    // Set up form and submit it.
    $edit['name'] = $this->authUser->name;
    // Pass is already set in the $edit array.
    $this->drupalPost('user/', $edit, t('Log in'));

    $this->assertNoText(t('The password you supplied appears in'),
      'Warning not issued about compromised password.');
    $this->assertNoText(t('Your current password appears in'),
      'User login with a good password was not blocked.');
    $this->assertRaw('<a href="/user/' . $this->authUser->uid . '/edit">Edit</a>',
      'User logged in successfully.');
  }

  /**
   * Test user logging in with a bad password; default is to Warn.
   */
  public function testUserLoginBadPassword() {

    // Update the stored password for the user.
    $edit['pass'] = 'qwerty';
    user_save($this->authUser, $edit);

    // Set up form and submit it.
    $edit['name'] = $this->authUser->name;
    // Pass is already set in the $edit array.
    $this->drupalPost('user/', $edit, t('Log in'));

    $this->assertText(t('Your current password appears in'),
      'Warning issued about compromised password.');
    $this->assertNoText(t('previous data breaches. You need to'),
      'User login with a bad password was not blocked.');
    $this->assertRaw('<a href="/user/' . $this->authUser->uid . '/edit">Edit</a>',
      'User logged in successfully.');
  }

  /**
   * Test user logging in with a bad password with policy set to Ignore.
   */
  public function testUserLoginBadPasswordPolicyIgnore() {

    // Set Change Policy to Ignore.
    variable_set('password_haveibeenpwned_login_policy', PASSWORD_HAVEIBEENPWNED_IGNORE);

    // Update the stored password for the user.
    $edit['pass'] = 'qwerty';
    user_save($this->authUser, $edit);

    // Set up form and submit it.
    $edit['name'] = $this->authUser->name;
    // Pass is already set in the $edit array.
    $this->drupalPost('user/', $edit, t('Log in'));

    $this->assertNoText(t('The password you supplied appears in'),
      'Warning not issued about compromised password.');
    $this->assertNoText(t('Your current password appears in'),
      'User login with a bad password was not blocked.');
    $this->assertRaw('<a href="/user/' . $this->authUser->uid . '/edit">Edit</a>',
      'User logged in successfully.');
  }

  /**
   * Test user logging in with a bad password with policy set to Block.
   */
  public function testUserLoginBadPasswordPolicyBlock() {

    // Set Change Policy to Ignore.
    variable_set('password_haveibeenpwned_login_policy', PASSWORD_HAVEIBEENPWNED_BLOCK);

