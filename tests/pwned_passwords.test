  /**
   * Test user logging in with an incorrect password.
   */
  public function testUserLoginIncorrectPassword() {

    // Update the stored password for the user.
    $edit['pass'] = 'qwerty';
    user_save($this->authUser, $edit);

    // Try to login with a different bad password.
    $edit['pass'] = 'monkey';

    // Set up form and submit it.
    $edit['name'] = $this->authUser->name;
    // Pass is already set in the $edit array.
    $this->backdropPost('user/', $edit, t('Log in'));

    $this->assertNoText(t('Your current password appears in'),
      'No warning issued about compromised password when login failed.');
    $this->assertNoText(t('previous data breaches. You need to'),
      'User login with a bad password was not blocked.');
    $this->assertNoRaw('<a href="/user/' . $this->authUser->uid . '/edit">Edit</a>',
      'User did not log in successfully.');
  }

  /**
   * Test user logging in with an incorrect password with checked failed logins.
   */
  public function testUserLoginIncorrectPasswordCheckFailedLogins() {

    // Check passwords even when login fails (not the default).
    // TODO This variable was probably removed in Backdrop without replacement.
    variable_set('pwned_passwords_check_failed_login', TRUE);

    // Update the stored password for the user.
    $edit['pass'] = 'qwerty';
    user_save($this->authUser, $edit);

    // Try to login with a different bad password.
    $edit['pass'] = 'monkey';

    // Set up form and submit it.
    $edit['name'] = $this->authUser->name;
    // Pass is already set in the $edit array.
    $this->backdropPost('user/', $edit, t('Log in'));

    $this->assertText(t('The password you supplied appears in'),
      'Warning issued about compromised password despite failed login.');
    $this->assertNoText(t('previous data breaches. You need to'),
      'User login with a bad password was not blocked.');
    $this->assertNoRaw('<a href="/user/' . $this->authUser->uid . '/edit">Edit</a>',
      'User did not log in successfully.');
  }

  /**
   * Test the Add-Padding functionality in HIBP API calls.
   */
  public function testAddPadding() {
    config_set('pwned_passwords_test.settings', 'pwned_passwords_test_log_headers', TRUE);
    $result = pwned_passwords_check_password('qwerty');
    $this->assertTrue($result, '"qwerty" is a bad password');

    // TODO This variable was probably removed in Backdrop without replacement.
    $hibp_padding = variable_get('pwned_passwords_add_padding', pwned_passwords_PADDING_DEFAULT) ? 'true' : 'false';
    $log_pattern = '"add-padding":"' . $hibp_padding . '"';

    $logged = (bool) db_query_range(
      'SELECT 1 FROM {watchdog} WHERE type = :pwned_passwords_test AND message LIKE :log_pattern',
      0,
      1,
      array(
      ':pwned_passwords_test' => 'pwned_passwords_test',
      ':log_pattern' => '%' . db_like($log_pattern) . '%',
    )
    )->fetchField();
    $this->assertTrue($logged, 'Correct Add-Padding header received by the mock API endpoint.');
  }

}

/**
 * Provides another test class and helper methods for automated tests.
 */
class PwnedPasswordsNoPaddingTestCase extends PwnedPasswordsTestCase {

  /**
   * {@inheritdoc}
   */
  public static function getInfo() {
    return array(
      'name' => 'Pwned Passwords no padding',
      'description' => 'Tests Pwned Passwords module without padding enabled',
      'group' => 'Pwned Passwords',
    );
  }

  /**
   * {@inheritdoc}
   */
  public function setUp() {
    parent::setUp();
    // TODO This variable was probably removed in Backdrop without replacement.
    variable_set('pwned_passwords_add_padding', FALSE);
  }

}
