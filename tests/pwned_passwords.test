  /**
   * Test changing a user password to a (reasonably) good one.
   */
  public function testUserEditGoodPassword() {

    $this->backdropLogin($this->authUser);

    $edit['pass[pass1]'] = $edit['pass[pass2]'] = '6d296a0956e0d5a4a0c1f1a02d408bf6';
    $this->backdropPost('user/' . $this->authUser->uid . '/edit', $edit, t('Save'));

    $this->assertNoText(t('The password you supplied appears in'),
      'Warning not issued about compromised password.');
    $this->assertNoText(t('The new password you supplied appears in'),
      'User edit with a good password was not blocked.');
    $this->assertText(t('The changes have been saved.'),
      'New (good) password was saved.');
  }

  /**
   * Test changing a user password to a bad one; by default should be blocked.
   */
  public function testUserEditBadPassword() {

    $this->backdropLogin($this->authUser);

    $edit['pass[pass1]'] = $edit['pass[pass2]'] = 'monkey';
    $this->backdropPost('user/' . $this->authUser->uid . '/edit', $edit, t('Save'));

    $this->assertText(t('The new password you supplied appears in'),
      'Warning issued about compromised password.');
    $this->assertText(t('You should choose a different password.'),
      'User edit with a bad password was blocked.');
    $this->assertNoText(t('The changes have been saved.'),
      'New (bad) password was not saved.');
  }

