<?php

/**
 * @file
 * Automated tests for the Pwned Passwords module.
 */

/**
 * Provides a base test class and helper methods for automated tests.
 */
class PwnedPasswordsTestCase extends BackdropWebTestCase {

  /**
   * An authenticated user.
   *
   * @var object
   */
  protected $authUser;

  /**
   * {@inheritdoc}
   */
  public static function getInfo() {
    return array(
      'name' => 'Pwned Passwords',
      'description' => 'Tests Pwned Passwords module',
      'group' => 'Pwned Passwords',
    );
  }

  /**
   * {@inheritdoc}
   */
  public function setUp() {
    config_set('system.core', 'clean_url', 1);
    global $base_url;

    // Enable module and dependencies.
    parent::setUp(
      array(
      'pwned_passwords',
      'pwned_passwords_test',
    )
    );

    // Switch HIBP API to use the mock endpoint.
    // TODO This variable was probably removed in Backdrop without replacement.
    variable_set('pwned_passwords_api_url', url('pwned_passwords_test/mock_api/', array('absolute' => TRUE)));

    $this->authUser = $this->backdropCreateUser(
      array(
      'access comments',
      'access content',
      'use text format filtered_html',
    )
    );
  }

  /**
   * Test user registering with a (reasonably) good password.
   */
  public function testUserRegisterGoodPassword() {
    // Set up the site so users can register immediately and provide a password.
    config_set('system.core', 'user_email_verification', FALSE);
    config_set('system.core', 'user_register', USER_REGISTER_VISITORS);

    // Set up form and submit it.
    $edit['name'] = $this->randomName();
    $edit['mail'] = $edit['name'] . '@example.com';
    $edit['pass[pass1]'] = $edit['pass[pass2]'] = '6d296a0956e0d5a4a0c1f1a02d408bf6';
    $this->backdropPost('user/register', $edit, t('Create new account'));

    $this->assertNoText(t('The password you supplied appears in'),
      'Warning not issued about compromised password.');
    $this->assertNoText(t('You need to choose a different password for your account.'),
      'User registration with a bad password was not blocked.');
    $this->assertText(t('Registration successful. You are now logged in.'),
      'User registered successfully.');
  }

  /**
   * Test user registering with a bad password; by default should be blocked.
   */
  public function testUserRegisterBadPassword() {
    // Set up the site so users can register immediately and provide a password.
    config_set('system.core', 'user_email_verification', FALSE);
    config_set('system.core', 'user_register', USER_REGISTER_VISITORS);

    // Set up form and submit it.
    $edit['name'] = $this->randomName();
    $edit['mail'] = $edit['name'] . '@example.com';
    $edit['pass[pass1]'] = $edit['pass[pass2]'] = 'qwerty';
    $this->backdropPost('user/register', $edit, t('Create new account'));

    $this->assertText(t('The password you supplied appears in'),
      'Warning issued about compromised password.');
    $this->assertText(t('You need to choose a different password for your account.'),
      'User registration with a bad password was blocked.');
    $this->assertNoText(t('Registration successful. You are now logged in.'),
      'User was not registered successfully.');
  }

